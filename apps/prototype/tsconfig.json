{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "next.config.ts"
  ],
  "//exclude-server": "src/server holds the WebSocket Lambda (imports 'sst' + '@aws-sdk/*', bundled only by SST at deploy) — kept out of the app typecheck/build.",
  "exclude": ["node_modules", ".next", "src/server"]
}
